; Engine configuration file.
; Godot 4.7.2 — DEITY, a 3D god simulator.
config_version=5

[application]
config/name="DEITY"
config/description="A 3D deity simulator. Create worlds, introduce humanity, and wield unrestricted divine power while civilizations live on their own."
config/version="1.0.0"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
GameState="*res://scripts/autoload/GameState.gd"
Gfx="*res://scripts/autoload/Gfx.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/min_width=1024
window/size/min_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]
pause_menu={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[internationalization]
locale/fallback="en"

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.35, 0.58, 0.82, 1)
textures/canvas_textures/default_texture_filter=1

[physics]
3d/run_on_separate_thread=false

[debug]
gdscript/warnings/unused_parameter=false
gdscript/warnings/unused_signal=false
gdscript/warnings/integer_division=false
